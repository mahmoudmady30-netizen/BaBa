# Copy this file to "secrets.properties" (same folder) and fill in your
# real values there. "secrets.properties" is in .gitignore — it will
# NEVER be committed to git, even if you push the whole project folder.
#
# This file (secrets.properties.example) is safe to commit — it has no
# real secrets in it, just placeholders.
#
# This is only needed for building locally in Android Studio. Building
# via GitHub Actions does NOT need this file — it reads the same values
# from GitHub repository secrets instead (see README.md for setup steps).

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# --- Release signing (only needed to build a Google Play AAB locally) ---
# Not needed for debug builds or for the GitHub Actions AAB workflow,
# which reads these from repository secrets instead.
# See RELEASE_GUIDE.md for how to generate the keystore.
KEYSTORE_FILE=/absolute/path/to/upload-keystore.jks
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=baba-upload
KEY_PASSWORD=your_key_password
